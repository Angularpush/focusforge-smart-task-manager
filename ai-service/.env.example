# FocusForge AI Service Environment Variables
# Copy this file to .env and fill in your values

# Service Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Database Configuration
# MongoDB (Vector storage & documents)
MONGODB_URL=mongodb://focusforge:dev_password_123@localhost:27017/focusforge
MONGODB_DATABASE=focusforge

# Redis (Pub/Sub with Backend)
REDIS_URL=redis://:dev_password_123@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=dev_password_123
REDIS_DB=0

# AI Model Configuration
# OpenAI (Primary)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=30

# Ollama (Local Alternative)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_ENABLED=false
OLLAMA_TIMEOUT=60

# LangChain Configuration
LANGCHAIN_VERBOSE=true
LANGCHAIN_DEBUG=false
LANGCHAIN_TRACING_V2=false

# Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=us-west1-gcp
PINECONE_INDEX_NAME=focusforge
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536

# NLP Configuration
SPACY_MODEL=en_core_web_sm
DATEPARSER_SETTINGS={"PREFER_DATES_FROM":"future","STRICT_PARSING":false}
TASK_PARSING_CONFIDENCE_THRESHOLD=0.8

# Chat Configuration
CHAT_MAX_HISTORY=20
CHAT_CONTEXT_WINDOW=10
CHAT_MEMORY_TYPE=buffer  # buffer, summary, or vector
CHAT_MAX_TOKENS=500
CHAT_TEMPERATURE=0.7

# Scheduling Engine Configuration
SCHEDULING_URGENCY_WEIGHT=0.4
SCHEDULING_COMPLEXITY_WEIGHT=0.3
SCHEDULING_FATIGUE_WEIGHT=0.2
SCHEDULING_DEPENDENCY_WEIGHT=0.1
SCHEDULING_MAX_TASKS_PER_DAY=8
SCHEDULING_DEFAULT_TASK_DURATION=60  # minutes

# Redis Pub/Sub Channels
REDIS_CHAT_CHANNEL_PREFIX=chat
REDIS_TASK_CHANNEL_PREFIX=task
REDIS_STATUS_CHANNEL_PREFIX=status

# Logging Configuration
LOG_LEVEL=DEBUG
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/ai-service.log

# Security
API_KEY_HEADER=X-API-Key
API_KEY=your_ai_service_api_key
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Performance
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=30
CACHE_TTL=3600  # seconds

# Feature Flags
ENABLE_TASK_PARSING=true
ENABLE_CHAT_RESPONSES=true
ENABLE_SCHEDULING=true
ENABLE_MEMORY_PERSISTENCE=true
ENABLE_ANALYTICS=true

# Development Settings
DEV_MODE=true
DEV_MOCK_RESPONSES=false
DEV_LOG_REQUESTS=true
DEV_SAVE_INTERACTIONS=true