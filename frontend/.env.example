# FocusForge Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# API Configuration
REACT_APP_API_URL=http://localhost:3001
REACT_APP_WEBSOCKET_URL=http://localhost:3001

# Firebase Configuration
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=1234567890
REACT_APP_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Application Settings
REACT_APP_APP_NAME=FocusForge
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_AI_FEATURES=true
REACT_APP_ENABLE_ADVANCED_DASHBOARD=true

# Chart.js Configuration
REACT_APP_CHART_DEFAULT_COLOR=#3b82f6
REACT_APP_CHART_SUCCESS_COLOR=#22c55e
REACT_APP_CHART_WARNING_COLOR=#f59e0b
REACT_APP_CHART_ERROR_COLOR=#ef4444

# Focus Timer Settings (minutes)
REACT_APP_DEFAULT_POMODORO_DURATION=25
REACT_APP_DEFAULT_BREAK_DURATION=5
REACT_APP_DEFAULT_LONG_BREAK_DURATION=15

# UI Settings
REACT_APP_DEFAULT_THEME=light
REACT_APP_DEFAULT_TIMEZONE=America/New_York
REACT_APP_DEFAULT_WEEKLY_GOAL_HOURS=20